-- Vidhya marketing dashboard — modified to re-attribute `seekhomalayalam%`
-- campaigns (operated from the Vidhya ad account) from Seekho into Vidhya.

WITH cost_etl AS (
    SELECT DISTINCT
        date,
        media_source,
        app_id,
        campaign,
        adset,
        ad_id AS ad,
        channel,
        original_cost,
        impressions,
        clicks,
        installs
    FROM `seekho-c084b.appsflyer.cost_etl`
    WHERE TRUE
      AND DATE(TIMESTAMP(date)) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND LOWER(campaign) NOT LIKE '%resurrect%'
      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
      AND (
            app_id LIKE '%vidhya%'
         OR LOWER(campaign) LIKE 'seekhomalayalam%'
      )
),

downloads AS (
    SELECT DATE(`Install Time`,"Asia/Kolkata") AS date_tz,
        CASE
            WHEN LOWER(`Media Source`) LIKE '%googleadwords%' THEN 'google'
            WHEN LOWER(`Media Source`) LIKE '%facebook%'      THEN 'facebook'
            WHEN LOWER(`Media Source`) LIKE '%snapchat%'      THEN 'snapchat'
            ELSE 'facebook'
        END AS source,
        COUNT(DISTINCT `Advertising ID`) AS cnt
    FROM `seekho-c084b.appsflyer.installs`
    WHERE (
            `Bundle ID` LIKE '%vidhya%'
         OR LOWER(campaign) LIKE 'seekhomalayalam%'
    )
    GROUP BY 1,2
),
downloads_agg AS (
    SELECT date_tz,
        SUM(CASE WHEN source='google'   THEN cnt ELSE 0 END) AS google_installs,
        SUM(CASE WHEN source='facebook' THEN cnt ELSE 0 END) AS facebook_installs,
        SUM(CASE WHEN source='snapchat' THEN cnt ELSE 0 END) AS snapchat_installs,
        SUM(cnt)                                              AS total_installs
    FROM downloads
    GROUP BY 1
),

mktg_costs AS (
    SELECT DISTINCT
        DATE(TIMESTAMP(date)) AS date_tz,
        LOWER(app_id)         AS app_id,
        LOWER(media_source)   AS source,
        LOWER(campaign)       AS campaign,
        LOWER(adset)          AS adset,
        LOWER(ad)             AS ad,
        LOWER(channel)        AS channel,
        MAX(original_cost)    AS cost,
        MAX(impressions)      AS impressions,
        MAX(clicks)           AS clicks,
        MAX(installs)         AS installs
    FROM cost_etl
    WHERE DATE(TIMESTAMP(date)) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
    GROUP BY 1,2,3,4,5,6,7
),
mktg AS (
    SELECT
        date_tz,
        CASE
            WHEN source IS NULL                THEN 'null'
            WHEN source LIKE '%googleadwords%' THEN 'google'
            WHEN source LIKE '%facebook%'      THEN 'facebook'
            WHEN source LIKE '%snapchat%'      THEN 'snapchat'
            ELSE source
        END AS source,
        ROUND(SUM(cost))        AS total_cost,
        ROUND(SUM(impressions)) AS impressions,
        ROUND(SUM(clicks))      AS clicks,
        ROUND(SUM(installs))    AS installs
    FROM mktg_costs
    GROUP BY 1,2
    ORDER BY date_tz DESC, source DESC
),
aggregated AS (
    SELECT
        DATE(date_tz) AS date,
        SUM(CASE WHEN source='google'   THEN total_cost ELSE 0 END) AS google_cost,
        SUM(CASE WHEN source='facebook' THEN total_cost ELSE 0 END) AS facebook_cost,
        SUM(CASE WHEN source='snapchat' THEN total_cost ELSE 0 END) AS snapchat_cost,
        SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END) AS total_cost,
        SUM(CASE WHEN source='google'   THEN installs   ELSE 0 END) AS google_installs,
        SUM(CASE WHEN source='facebook' THEN installs   ELSE 0 END) AS facebook_installs,
        SUM(CASE WHEN source='snapchat' THEN installs   ELSE 0 END) AS snapchat_installs,
        SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN installs ELSE 0 END) AS total_installs,
        CONCAT(CAST(ROUND(100.0 * SUM(CASE WHEN source='facebook' THEN total_cost ELSE 0 END) /
              NULLIF(SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END),0), 2) AS STRING), '%') AS facebook_pct_spend,
        CONCAT(CAST(ROUND(100.0 * SUM(CASE WHEN source='google'   THEN total_cost ELSE 0 END) /
              NULLIF(SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END),0), 2) AS STRING), '%') AS google_pct_spend,
        CONCAT(CAST(ROUND(100.0 * SUM(CASE WHEN source='snapchat' THEN total_cost ELSE 0 END) /
              NULLIF(SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END),0), 2) AS STRING), '%') AS snapchat_pct_spend
    FROM mktg
    GROUP BY date_tz
),

-- NEW: profile_ids of users whose attributed AppsFlyer install was on a seekhomalayalam% campaign.
vidhya_account_payers AS (
    SELECT DISTINCT uai.profile_id
    FROM `seekho-c084b.appsflyer.installs` i
    JOIN `seekho-c084b.seekho.users_userappinfo` uai
         ON i.`Advertising ID` = uai.advertising_id
        AND uai.advertising_id NOT IN ('00000000-0000-0000-0000-000000000000','0000-0000')
    WHERE DATE(i.`Install Time`,"Asia/Kolkata") >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND LOWER(i.campaign) LIKE 'seekhomalayalam%'
),

d0_data AS (
    SELECT
        DATE(pph.purchased_on, "Asia/Kolkata") AS Payment_date,
        COUNT(DISTINCT CASE
              WHEN DATE_DIFF(CAST(DATE(pph.purchased_on, "Asia/Kolkata") AS DATE),
                             CAST(DATE(uup.signedup_on, "Asia/Kolkata") AS DATE), DAY) = 0
              THEN eo.profile_id END) AS D0,
        COUNT(DISTINCT CASE
              WHEN DATE_DIFF(CAST(DATE(pph.purchased_on, "Asia/Kolkata") AS DATE),
                             CAST(DATE(uup.signedup_on, "Asia/Kolkata") AS DATE), DAY) > 0
              THEN eo.profile_id END) AS D0_Plus,
        COUNT(DISTINCT CASE
              WHEN DATE_DIFF(CAST(DATE(pph.purchased_on, "Asia/Kolkata") AS DATE),
                             CAST(DATE(uup.signedup_on, "Asia/Kolkata") AS DATE), DAY) >= 0
              THEN eo.profile_id END) AS Total
    FROM `seekho-c084b.seekho.experiments_order` AS eo
    LEFT JOIN `seekho-c084b.seekho.experiments_profilepurchasehistory` AS pph ON eo.id = pph.order_id
    LEFT JOIN `seekho-c084b.seekho.payments_subscriptionvalidity` AS ps        ON ps.purchase_record_id = pph.id
    LEFT JOIN `seekho-c084b.seekho.users_userprofile` uup                      ON eo.profile_id = uup.user_ptr_id
    WHERE eo.is_prod = TRUE
      AND pph.is_prod = TRUE
      AND eo.status = 'order_paid'
      AND (subscription_type LIKE '%new%' OR subscription_type LIKE '%monthly%')
      AND eo.premium_plan_id IS NOT NULL
      AND CAST(DATE(pph.purchased_on, "Asia/Kolkata") AS DATE) >= '2025-01-01'
      AND (
            eo.order_source LIKE '%vidhya%'
         OR eo.profile_id IN (SELECT profile_id FROM vidhya_account_payers)
      )
    GROUP BY DATE(pph.purchased_on, "Asia/Kolkata")
),

paid AS (
    SELECT DISTINCT
        DATE(pph.purchased_on,"Asia/Kolkata") AS payment_date,
        eo.id,
        eo.profile_id,
        eo.pgw_amount
    FROM `seekho-c084b.seekho.experiments_order` eo
    LEFT JOIN `seekho-c084b.seekho.experiments_profilepurchasehistory` pph ON eo.id = pph.order_id
    LEFT JOIN `seekho-c084b.seekho.payments_subscriptionvalidity`      sv  ON pph.id = sv.purchase_record_id
    WHERE eo.status = 'order_paid'
      AND eo.premium_item_id IS NULL
      AND eo.is_prod = TRUE
      AND (subscription_type LIKE '%new%' OR subscription_type LIKE '%monthly%')
      AND DATE(pph.purchased_on, 'Asia/Kolkata') >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND DATE(pph.purchased_on, 'Asia/Kolkata') <  CURRENT_DATE("Asia/Kolkata")
      AND (
            eo.order_source LIKE '%vidhya%'
         OR eo.profile_id IN (SELECT profile_id FROM vidhya_account_payers)
      )
),

ad_id AS (
    SELECT DISTINCT
        profile_id,
        advertising_id AS gaid,
        DATE(MAX(created_on),"Asia/Kolkata") AS date_created
    FROM `seekho-c084b.seekho.users_userappinfo`
    GROUP BY 1,2
),

u_duf AS (
    SELECT DATE(date_tz) AS date_tz, user_id
    FROM `seekho-c084b.analytics_growth.s_daily_user_funnel`
    WHERE date_tz >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND date_tz <  CURRENT_DATE("Asia/Kolkata")
      AND active_user = 1
    UNION DISTINCT
    SELECT DATE(date_tz) AS date_tz, user_id
    FROM `seekho-c084b.analytics_growth.s_daily_user_funnel_intraday`
    WHERE date_tz >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 1 DAY)
      AND date_tz <  CURRENT_DATE("Asia/Kolkata")
      AND active_user = 1
),

ula AS (
    SELECT *, DATE(`Install Time`,"Asia/Kolkata") AS date_tz
    FROM `seekho-c084b.appsflyer.installs`
    WHERE DATE(`Install Time`) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND `Advertising ID` <> '00000000-0000-0000-0000-000000000000'
      AND `Advertising ID` <> '0000-0000'
      AND (
            `Bundle ID` LIKE '%vidhya%'
         OR LOWER(campaign) LIKE 'seekhomalayalam%'
      )
),
re AS (
    SELECT DISTINCT
        ula.date_tz AS date_tz,
        firebase_uid AS user_id,
        CASE
             WHEN ula.`Media Source` IS NULL                  THEN 'null'
             WHEN LOWER(`Media Source`) LIKE '%googleadwords%' THEN 'google'
             WHEN LOWER(`Media Source`) LIKE '%facebook%'      THEN 'facebook'
             WHEN LOWER(`Media Source`) LIKE '%snapchat%'      THEN 'snapchat'
             ELSE LOWER(`Media Source`)
        END AS source,
        CASE
             WHEN ula.campaign IS NULL THEN 'null'
             ELSE LOWER(ula.campaign)
        END AS campaign,
        CASE
             WHEN ula.Adset IS NULL                       THEN 'null'
             WHEN LOWER(ula.campaign) LIKE '%female%'     THEN CONCAT(LOWER(ula.Adset), " - female")
             ELSE LOWER(ula.Adset)
        END AS ad_set,
        paid.payment_date,
        paid.pgw_amount
    FROM ula
    LEFT JOIN ad_id
           ON ula.`Advertising ID` = ad_id.gaid
          AND ad_id.gaid NOT IN ('00000000-0000-0000-0000-000000000000','0000-0000')
    LEFT JOIN `seekho-c084b.seekho.users_userprofile` uup ON ad_id.profile_id = uup.user_ptr_id
    LEFT JOIN paid                                         ON uup.user_ptr_id = paid.profile_id
