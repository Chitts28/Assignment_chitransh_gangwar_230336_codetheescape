      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
