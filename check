    SAFE_DIVIDE(100*p.facebook_d0_orders,agg.facebook_installs) AS Facebook_D0_conversion,

    SAFE_DIVIDE(100*f.total_active_users,    agg.total_installs)   AS total_active_to_installs,
    SAFE_DIVIDE(100*f.google_active_users,   agg.google_installs)  AS google_active_to_installs,
    SAFE_DIVIDE(100*f.facebook_active_users, agg.facebook_installs) AS Facebook_active_to_installs,

    SAFE_DIVIDE(100*p.D0_orders,          f.total_active_users)    AS total_paid_to_active,
    SAFE_DIVIDE(100*p.google_d0_orders,   f.google_active_users)   AS google_paid_to_active,
