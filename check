-- Seekho marketing dashboard — modified to negate `seekhomalayalam%` campaigns
-- (operated from the Vidhya ad account) out of Seekho.

WITH moloco_metrics AS (
  WITH cost_etl AS (
    SELECT DISTINCT
        DATE(TIMESTAMP(date), "Asia/Kolkata") AS date_tz,
        media_source,
        app_id,
        campaign,
        ad_id AS ad,
        original_cost,
        installs
    FROM `seekho-c084b.appsflyer.cost_etl`
    WHERE TRUE
      AND DATE(TIMESTAMP(date)) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND ( app_id IN ('android','com.seekho.android','ios','com.seekho.ios','web','com.seekho.web')
            OR app_id IS NULL )
      AND ( LOWER(campaign) NOT LIKE 'seekhomalayalam%' OR campaign IS NULL )
  ),
  mktg AS (
    SELECT DISTINCT
        date_tz,
        media_source AS source,
        SUM(CASE WHEN date_tz BETWEEN DATE '2025-09-01' AND DATE '2025-12-31' THEN original_cost ELSE 0 END) AS cost,
        SUM(CASE WHEN date_tz BETWEEN DATE '2025-09-01' AND DATE '2025-12-31' THEN installs      ELSE 0 END) AS installs
    FROM cost_etl
    WHERE date_tz > "2025-09-01"
      AND media_source = "moloco_int"
    GROUP BY 1,2
    ORDER BY 1
  ),
  downloads AS (
    SELECT
        DATE(`Install Time`,"Asia/Kolkata") AS date_tz,
        CASE WHEN LOWER(`Media Source`) LIKE '%moloco%' THEN 'moloco' ELSE 'other' END AS source,
        COUNT(DISTINCT `Advertising ID`) AS cnt
    FROM `seekho-c084b.appsflyer.installs`
    WHERE ( `Bundle ID` IN ('android','com.seekho.android','ios','com.seekho.ios','web','com.seekho.web')
            OR `Bundle ID` IS NULL )
      AND ( LOWER(campaign) NOT LIKE 'seekhomalayalam%' OR campaign IS NULL )
    GROUP BY 1,2
    ORDER BY 1 DESC
  ),
  downloads_agg AS (
    SELECT date_tz, SUM(CASE WHEN source='moloco' THEN cnt ELSE 0 END) AS moloco_installs
    FROM downloads
    GROUP BY 1
  ),
  aggregated AS (
    SELECT
        DATE(date_tz) AS date,
        SUM(CASE WHEN source LIKE '%moloco%' THEN cost     ELSE 0 END) AS moloco_cost,
        SUM(CASE WHEN source LIKE '%moloco%' THEN installs ELSE 0 END) AS moloco_installs
    FROM mktg
    GROUP BY date_tz
  )
  SELECT
      DATE(a.date) AS date_tz,
      88*a.moloco_cost AS moloco_cost,
      moloco_installs
  FROM aggregated a
  ORDER BY a.date DESC
),

-- NEW: profile_ids whose attributed install was on a Vidhya-account (seekhomalayalam%) campaign.
vidhya_account_payers AS (
    SELECT DISTINCT uai.profile_id
    FROM `seekho-c084b.appsflyer.installs` i
    JOIN `seekho-c084b.seekho.users_userappinfo` uai
         ON i.`Advertising ID` = uai.advertising_id
        AND uai.advertising_id NOT IN ('00000000-0000-0000-0000-000000000000','0000-0000')
    WHERE DATE(i.`Install Time`,"Asia/Kolkata") >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND LOWER(i.campaign) LIKE 'seekhomalayalam%'
),

cost_etl AS (
    SELECT DISTINCT
        date,
        media_source,
        app_id,
        campaign,
        adset,
        ad_id AS ad,
        channel,
        original_cost,
        impressions,
        clicks,
        installs
    FROM `seekho-c084b.appsflyer.cost_etl`
    WHERE TRUE
      AND DATE(TIMESTAMP(date)) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND LOWER(campaign) NOT LIKE '%resurrect%'
      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
      AND LOWER(campaign) NOT LIKE '%sab_%'
      AND LOWER(campaign) NOT LIKE '%gtm%'
      AND LOWER(adset)    NOT LIKE '%gtm%'
      AND LOWER(campaign) NOT IN ('health scaling abo campaign')
      AND LOWER(campaign) NOT LIKE 'seekhomalayalam%'
      AND ( app_id IN ('android','com.seekho.android','ios','com.seekho.ios','web','com.seekho.web')
            OR app_id IS NULL )
),

downloads AS (
    SELECT DATE(`Install Time`,"Asia/Kolkata") AS date_tz,
        CASE
            WHEN LOWER(`Media Source`) LIKE '%googleadwords%' THEN 'google'
            WHEN LOWER(`Media Source`) LIKE '%facebook%'      THEN 'facebook'
            WHEN LOWER(`Media Source`) LIKE '%snapchat%'      THEN 'snapchat'
            ELSE 'facebook'
        END AS source,
        COUNT(DISTINCT `Advertising ID`) AS cnt
    FROM `seekho-c084b.appsflyer.installs`
    WHERE ( `Bundle ID` IN ('android','com.seekho.android','ios','com.seekho.ios','web','com.seekho.web')
            OR `Bundle ID` IS NULL )
      AND ( LOWER(campaign) NOT LIKE 'seekhomalayalam%' OR campaign IS NULL )
    GROUP BY 1,2
    ORDER BY 1 DESC
),
downloads_agg AS (
    SELECT date_tz,
        SUM(CASE WHEN source='google'   THEN cnt ELSE 0 END) AS google_installs,
        SUM(CASE WHEN source='facebook' THEN cnt ELSE 0 END) AS facebook_installs,
        SUM(CASE WHEN source='snapchat' THEN cnt ELSE 0 END) AS snapchat_installs,
        SUM(cnt)                                              AS total_installs
    FROM downloads
    GROUP BY 1
),

mktg_costs AS (
    SELECT DISTINCT
        DATE(TIMESTAMP(date)) AS date_tz,
        LOWER(app_id)         AS app_id,
        LOWER(media_source)   AS source,
        LOWER(campaign)       AS campaign,
        LOWER(adset)          AS adset,
        LOWER(ad)             AS ad,
        LOWER(channel)        AS channel,
        MAX(original_cost)    AS cost,
        MAX(impressions)      AS impressions,
        MAX(clicks)           AS clicks,
        MAX(installs)         AS installs
    FROM cost_etl
    WHERE DATE(TIMESTAMP(date)) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
    GROUP BY 1,2,3,4,5,6,7
),
mktg AS (
    SELECT
        date_tz,
        CASE
            WHEN source IS NULL                THEN 'null'
            WHEN source LIKE '%googleadwords%' THEN 'google'
            WHEN source LIKE '%facebook%'      THEN 'facebook'
            WHEN source LIKE '%snapchat%'      THEN 'snapchat'
            ELSE source
        END AS source,
        ROUND(SUM(cost))        AS total_cost,
        ROUND(SUM(impressions)) AS impressions,
        ROUND(SUM(clicks))      AS clicks,
        ROUND(SUM(installs))    AS installs
    FROM mktg_costs
    GROUP BY 1,2
    ORDER BY date_tz DESC, source DESC
),
aggregated AS (
    SELECT
        DATE(date_tz) AS date,
        SUM(CASE WHEN source='google'   THEN total_cost ELSE 0 END) AS google_cost,
        SUM(CASE WHEN source='facebook' THEN total_cost ELSE 0 END) AS facebook_cost,
        SUM(CASE WHEN source='snapchat' THEN total_cost ELSE 0 END) AS snapchat_cost,
        SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END) AS total_cost,
        SUM(CASE WHEN source='google'   THEN installs   ELSE 0 END) AS google_installs,
        SUM(CASE WHEN source='facebook' THEN installs   ELSE 0 END) AS facebook_installs,
        SUM(CASE WHEN source='snapchat' THEN installs   ELSE 0 END) AS snapchat_installs,
        SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN installs ELSE 0 END) AS total_installs,
        CONCAT(CAST(ROUND(100.0 * SUM(CASE WHEN source='facebook' THEN total_cost ELSE 0 END) /
              NULLIF(SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END),0), 2) AS STRING), '%') AS facebook_pct_spend,
        CONCAT(CAST(ROUND(100.0 * SUM(CASE WHEN source='google'   THEN total_cost ELSE 0 END) /
              NULLIF(SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END),0), 2) AS STRING), '%') AS google_pct_spend,
        CONCAT(CAST(ROUND(100.0 * SUM(CASE WHEN source='snapchat' THEN total_cost ELSE 0 END) /
              NULLIF(SUM(CASE WHEN source IN ('google','facebook','snapchat') THEN total_cost ELSE 0 END),0), 2) AS STRING), '%') AS snapchat_pct_spend
    FROM mktg
    GROUP BY date_tz
),

paid AS (
    SELECT DISTINCT
        DATE(pph.purchased_on,"Asia/Kolkata") AS payment_date,
        eo.id,
        eo.profile_id,
        eo.pgw_amount
    FROM `seekho-c084b.seekho.experiments_order` eo
    LEFT JOIN `seekho-c084b.seekho.experiments_profilepurchasehistory` pph ON eo.id = pph.order_id
    LEFT JOIN `seekho-c084b.seekho.payments_subscriptionvalidity`      sv  ON pph.id = sv.purchase_record_id
    WHERE eo.status = 'order_paid'
      AND eo.premium_item_id IS NULL
      AND eo.is_prod = TRUE
      AND ( eo.order_source IN ('android','com.seekho.android','ios','com.seekho.ios','web','com.seekho.web')
            OR eo.order_source IS NULL )
      AND (subscription_type LIKE '%new%' OR subscription_type LIKE '%monthly%')
      AND DATE(pph.purchased_on,"Asia/Kolkata") >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND DATE(pph.purchased_on,"Asia/Kolkata") <  CURRENT_DATE("Asia/Kolkata")
      AND eo.profile_id NOT IN (SELECT profile_id FROM vidhya_account_payers)
),
ad_id AS (
    SELECT DISTINCT
        profile_id,
        advertising_id AS gaid,
        DATE(MAX(created_on),"Asia/Kolkata") AS date_created
    FROM `seekho-c084b.seekho.users_userappinfo`
    GROUP BY 1,2
),

u_duf AS (
    SELECT DATE(date_tz) AS date_tz, user_id
    FROM `seekho-c084b.analytics_growth.s_daily_user_funnel`
    WHERE date_tz >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND date_tz <  CURRENT_DATE("Asia/Kolkata")
      AND active_user = 1
    UNION DISTINCT
    SELECT DATE(date_tz) AS date_tz, user_id
    FROM `seekho-c084b.analytics_growth.s_daily_user_funnel_intraday`
    WHERE date_tz >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 1 DAY)
      AND date_tz <  CURRENT_DATE("Asia/Kolkata")
      AND active_user = 1
),

ula AS (
    SELECT *, DATE(`Install Time`,"Asia/Kolkata") AS date_tz
    FROM `seekho-c084b.appsflyer.installs`
    WHERE DATE(`Install Time`,"Asia/Kolkata") >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      AND `Advertising ID` <> '00000000-0000-0000-0000-000000000000'
      AND `Advertising ID` <> '0000-0000'
      AND ( `Bundle ID` IN ('android','com.seekho.android','ios','com.seekho.ios',
                            'web','com.seekho.web','com.seekho.androie','com.seekho.android.preprod')
            OR `Bundle ID` IS NULL )
      AND ( LOWER(campaign) NOT LIKE 'seekhomalayalam%' OR campaign IS NULL )
),
re AS (
    SELECT DISTINCT
        ula.date_tz AS date_tz,
        firebase_uid AS user_id,
        uup.user_ptr_id AS profile_id,
        CASE
             WHEN ula.`Media Source` IS NULL                  THEN 'null'
             WHEN LOWER(`Media Source`) LIKE '%googleadwords%' THEN 'google'
             WHEN LOWER(`Media Source`) LIKE '%facebook%'      THEN 'facebook'
             WHEN LOWER(`Media Source`) LIKE '%snapchat%'      THEN 'snapchat'
             ELSE LOWER(`Media Source`)
        END AS source,
        CASE WHEN ula.campaign IS NULL THEN 'null' ELSE LOWER(ula.campaign) END AS campaign,
        CASE
             WHEN ula.Adset IS NULL                       THEN 'null'
             WHEN LOWER(ula.campaign) LIKE '%female%'     THEN CONCAT(LOWER(ula.Adset), " - female")
             ELSE LOWER(ula.Adset)
        END AS ad_set,
        paid.payment_date,
        paid.pgw_amount
    FROM ula
    LEFT JOIN ad_id
           ON ula.`Advertising ID` = ad_id.gaid
          AND ad_id.gaid NOT IN ('00000000-0000-0000-0000-000000000000','0000-0000')
    LEFT JOIN `seekho-c084b.seekho.users_userprofile` uup ON ad_id.profile_id = uup.user_ptr_id
    LEFT JOIN paid                                         ON uup.user_ptr_id = paid.profile_id
),

pre_d0_data AS (
    SELECT
        DATE(pph.purchased_on, "Asia/Kolkata") AS Payment_date,
        (CASE
              WHEN DATE_DIFF(CAST(DATE(pph.purchased_on, "Asia/Kolkata") AS DATE),
                             CAST(DATE(uup.signedup_on,  "Asia/Kolkata") AS DATE), DAY) >= 0
              THEN eo.profile_id END) AS Total
    FROM `seekho-c084b.seekho.experiments_order` AS eo
    LEFT JOIN `seekho-c084b.seekho.experiments_profilepurchasehistory` AS pph ON eo.id = pph.order_id
    LEFT JOIN `seekho-c084b.seekho.payments_subscriptionvalidity` AS ps        ON ps.purchase_record_id = pph.id
    LEFT JOIN `seekho-c084b.seekho.users_userprofile` uup                      ON eo.profile_id = uup.user_ptr_id
    WHERE eo.is_prod = TRUE
      AND pph.is_prod = TRUE
      AND eo.status = 'order_paid'
      AND ( eo.order_source IN ('android','com.seekho.android','ios','com.seekho.ios','web','com.seekho.web')
            OR eo.order_source IS NULL )
      AND (subscription_type LIKE '%new%' OR subscription_type LIKE '%monthly%')
      AND eo.premium_plan_id IS NOT NULL
      AND CAST(DATE(pph.purchased_on, "Asia/Kolkata") AS DATE) >= '2025-01-01'
      AND eo.profile_id NOT IN (SELECT profile_id FROM vidhya_account_payers)
),

d0_data AS (
  SELECT
    a.Payment_date,
    COUNT(DISTINCT a.total) AS total
  FROM pre_d0_data a
  WHERE NOT EXISTS (
    SELECT 1
    FROM re b
    WHERE a.total = b.profile_id
      AND ( LOWER(b.campaign) LIKE '%gtm%'
         OR LOWER(b.campaign) IN ('health scaling abo campaign')
         OR LOWER(b.ad_set)   LIKE '%gtm%' )
  )
  GROUP BY 1
),

act_u AS (
    SELECT date_tz, source, COUNT(DISTINCT user_id) AS active_users
    FROM re
    WHERE LOWER(campaign) NOT LIKE '%resurrect%'
      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
      AND LOWER(campaign) NOT LIKE '%sab_%'
      AND LOWER(campaign) NOT LIKE '%gtm%'
      AND LOWER(ad_set)   NOT LIKE '%gtm%'
      AND LOWER(campaign) NOT IN ('health scaling abo campaign')
    GROUP BY 1,2
),

f_act_u AS (
    SELECT re.date_tz,
        COUNT(DISTINCT CASE WHEN re.source='google'   THEN re.user_id END) AS google_active_users,
        COUNT(DISTINCT CASE WHEN re.source='facebook' THEN re.user_id END) AS facebook_active_users,
        COUNT(DISTINCT re.user_id)                                          AS total_active_users
    FROM re
    JOIN u_duf ON re.user_id = u_duf.user_id AND DATE_DIFF(re.date_tz, u_duf.date_tz, DAY) = 0
    WHERE LOWER(campaign) NOT LIKE '%resurrect%'
      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
      AND LOWER(campaign) NOT LIKE '%sab_%'
      AND LOWER(campaign) NOT LIKE '%gtm%'
      AND LOWER(ad_set)   NOT LIKE '%gtm%'
      AND LOWER(campaign) NOT IN ('health scaling abo campaign')
    GROUP BY 1
),

pay_u AS (
    SELECT date_tz, source,
        COUNT(DISTINCT CASE WHEN DATE_DIFF(payment_date, date_tz, DAY) =  0 THEN user_id END) AS D0_paid_users,
        COUNT(DISTINCT CASE WHEN DATE_DIFF(payment_date, date_tz, DAY) >  0 THEN user_id END) AS D0_plus_paid_users,
        COUNT(DISTINCT CASE WHEN DATE_DIFF(payment_date, date_tz, DAY) <= 7 THEN user_id END) AS W0_paid_users,
        COUNT(DISTINCT CASE WHEN DATE_DIFF(payment_date, date_tz, DAY) <=30 THEN user_id END) AS M0_paid_users
    FROM re
    WHERE LOWER(campaign) NOT LIKE '%resurrect%'
      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
      AND LOWER(campaign) NOT LIKE '%sab_%'
      AND LOWER(campaign) NOT LIKE '%gtm%'
      AND LOWER(ad_set)   NOT LIKE '%gtm%'
      AND LOWER(campaign) NOT IN ('health scaling abo campaign')
    GROUP BY 1,2
),

w0_count AS (
    SELECT payment_date, COUNT(DISTINCT user_id) AS paid_users
    FROM re
    WHERE LOWER(campaign) NOT LIKE '%resurrect%'
      AND LOWER(campaign) NOT LIKE '%re-market%'
      AND LOWER(campaign) NOT IN ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      AND LOWER(campaign) NOT LIKE '%reengagement%'
      AND LOWER(campaign) NOT LIKE '%sab_%'
      AND LOWER(campaign) NOT LIKE '%gtm%'
      AND LOWER(ad_set)   NOT LIKE '%gtm%'
      AND LOWER(campaign) NOT IN ('health scaling abo campaign')
    GROUP BY 1
),

d0_paid_metrics AS (
  SELECT
    pu.date_tz AS date,
    SUM(pu.D0_paid_users)                                                AS d0_orders,
    SUM(pu.D0_plus_paid_users)                                           AS d0_plus_orders,
    SUM(CASE WHEN pu.source='google'   THEN pu.D0_paid_users ELSE 0 END) AS google_d0_orders,
    SUM(CASE WHEN pu.source='facebook' THEN pu.D0_paid_users ELSE 0 END) AS facebook_d0_orders,
    SUM(CASE WHEN pu.source='snapchat' THEN pu.D0_paid_users ELSE 0 END) AS snapchat_d0_orders,
    SUM(CASE WHEN m.source='google'    THEN m.total_cost     ELSE 0 END) AS google_total_cost,
    SUM(CASE WHEN m.source='facebook'  THEN m.total_cost     ELSE 0 END) AS facebook_total_cost,
    SUM(CASE WHEN m.source='snapchat'  THEN m.total_cost     ELSE 0 END) AS snapchat_total_cost
  FROM pay_u pu
  LEFT JOIN mktg m ON pu.date_tz = m.date_tz AND pu.source = m.source
  GROUP BY 1
)

SELECT
    DATE(a.date) AS date,
    a.google_cost,
    a.facebook_cost,
    a.snapchat_cost,
    ROUND(COALESCE(m.moloco_cost,0)) AS moloco_cost,
    ROUND(a.total_cost + COALESCE(m.moloco_cost,0)) AS total_cost,
    SAFE_DIVIDE(100*a.google_cost,    a.total_cost + COALESCE(m.moloco_cost,0)) AS google_pct_spend,
    SAFE_DIVIDE(100*a.facebook_cost,  a.total_cost + COALESCE(m.moloco_cost,0)) AS facebook_pct_spend,
    SAFE_DIVIDE(100*a.snapchat_cost,  a.total_cost + COALESCE(m.moloco_cost,0)) AS snapchat_pct_spend,
    SAFE_DIVIDE(100*COALESCE(m.moloco_cost,0), a.total_cost + COALESCE(m.moloco_cost,0)) AS moloco_pct_spend,
    p.D0_orders,
    d.total - p.D0_orders                                       AS D0_plus_orders,
    SAFE_DIVIDE(100*p.D0_orders, d.total)                       AS D0_orders_share,
    SAFE_DIVIDE(100*(d.total - p.D0_orders), d.total)           AS D0_plus_orders_share,
    d.total                                                     AS total_orders,
    p.google_d0_orders,
    p.facebook_d0_orders,
    p.snapchat_d0_orders,
    SAFE_DIVIDE(p.google_total_cost,   p.google_d0_orders)      AS google_D0_CAC,
    SAFE_DIVIDE(p.facebook_total_cost, p.facebook_d0_orders)    AS facebook_D0_CAC,
    SAFE_DIVIDE(p.snapchat_total_cost, p.snapchat_d0_orders)    AS snapchat_D0_CAC,
    SAFE_DIVIDE(a.total_cost + COALESCE(m.moloco_cost,0), p.D0_orders) AS D0_CAC,
    SAFE_DIVIDE(a.total_cost + COALESCE(m.moloco_cost,0), d.total)     AS total_CAC,
    agg.google_installs,
    agg.facebook_installs,
    agg.snapchat_installs,
    agg.total_installs + COALESCE(m.moloco_installs,0) AS total_installs,
    SAFE_DIVIDE(a.google_cost,    agg.google_installs)          AS google_CPI,
    SAFE_DIVIDE(a.facebook_cost,  agg.facebook_installs)        AS facebook_CPI,
    SAFE_DIVIDE(a.snapchat_cost,  agg.snapchat_installs)        AS snapchat_CPI,
    SAFE_DIVIDE(a.total_cost + COALESCE(m.moloco_cost,0),
                agg.total_installs + COALESCE(m.moloco_installs,0))     AS total_CPI,

    SAFE_DIVIDE(100*p.D0_orders,
                agg.total_installs + COALESCE(m.moloco_installs,0))     AS total_D0_conversion,
    SAFE_DIVIDE(100*p.google_d0_orders,   agg.google_installs)          AS Google_D0_conversion,
    SAFE_DIVIDE(100*p.facebook_d0_orders, agg.facebook_installs)        AS Facebook_D0_conversion,

    SAFE_DIVIDE(100*f.total_active_users,
                agg.total_installs + COALESCE(m.moloco_installs,0))     AS total_active_to_installs,
    SAFE_DIVIDE(100*f.google_active_users,   agg.google_installs)       AS google_active_to_installs,
    SAFE_DIVIDE(100*f.facebook_active_users, agg.facebook_installs)     AS Facebook_active_to_installs,

    SAFE_DIVIDE(100*p.D0_orders,          f.total_active_users)         AS total_paid_to_active,
    SAFE_DIVIDE(100*p.google_d0_orders,   f.google_active_users)        AS google_paid_to_active,
    SAFE_DIVIDE(100*p.facebook_d0_orders, f.facebook_active_users)      AS Facebook_paid_to_active,

    SUM(a.total_cost + COALESCE(m.moloco_cost,0)) OVER (
        PARTITION BY EXTRACT(MONTH FROM a.date), EXTRACT(YEAR FROM a.date)
        ORDER BY a.date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS MTD_spends,
    SUM(d.total) OVER (
        PARTITION BY EXTRACT(MONTH FROM a.date), EXTRACT(YEAR FROM a.date)
        ORDER BY a.date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS MTD_orders,
    SAFE_DIVIDE(
        SUM(a.total_cost + COALESCE(m.moloco_cost,0)) OVER (
            PARTITION BY EXTRACT(MONTH FROM a.date), EXTRACT(YEAR FROM a.date)
            ORDER BY a.date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
        SUM(d.total) OVER (
            PARTITION BY EXTRACT(MONTH FROM a.date), EXTRACT(YEAR FROM a.date)
            ORDER BY a.date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
    ) AS MTD_CAC

FROM aggregated a
LEFT JOIN d0_data          d   ON DATE(a.date) = DATE(d.Payment_date)
LEFT JOIN d0_paid_metrics  p   ON DATE(a.date) = DATE(p.date)
LEFT JOIN downloads_agg    agg ON DATE(a.date) = DATE(agg.date_tz)
LEFT JOIN f_act_u          f   ON DATE(a.date) = DATE(f.date_tz)
LEFT JOIN moloco_metrics   m   ON DATE(a.date) = DATE(m.date_tz)
WHERE DATE(a.date) BETWEEN DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
                       AND DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 1 DAY)
ORDER BY a.date DESC;

arivu
WITH cost_etl AS (
    SELECT DISTINCT
        date,
        media_source,
        app_id,
        campaign,
        adset,
        ad_id AS ad,
        channel,
        original_cost,
        impressions,
        clicks,
        installs
    FROM `seekho-c084b.appsflyer.cost_etl`
    WHERE TRUE
      AND DATE(TIMESTAMP(date)) >= DATE_SUB(CURRENT_DATE("Asia/Kolkata"), INTERVAL 60 DAY)
      and lower(campaign) not like '%resurrect%'
      and lower(campaign) not like '%re-market%'
      and lower(campaign) not in ('annual+monthly renewal remarketing - december','new categories installs campaign - 16dec')
      and lower(campaign) not like '%reengagement%'
      and (app_id like '%arivu%')
),

downloads as
(
select DATE(`Install Time`,"Asia/Kolkata") as date_tz,
CASE 
WHEN lower(`Media Source`) LIKE '%googleadwords%' THEN 'google'
WHEN lower(`Media Source`) LIKE '%facebook%' THEN 'facebook'
WHEN lower(`Media Source`) LIKE '%snapchat%' THEN 'snapchat'
else 'facebook' 
END AS source,
count(distinct `Advertising ID`) as cnt
